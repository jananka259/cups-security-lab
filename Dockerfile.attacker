FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    tcpdump \
    iproute2 \
    && python3 -m pip install --break-system-packages 'scapy>=2.5.0,<3' \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/lab
CMD ["sleep", "infinity"]
